// Rumus Power BI — salin satu measure per kali.

// RISK_KPI
Nilai_1_1 =
VAR pilihanAktif = SELECTEDVALUE('Filter_RISK'[Bulan laporan], "2026-05") RETURN CALCULATE(MAX('RISK_KPI'[K1]), 'RISK_KPI'[Pilihan] = pilihanAktif)

