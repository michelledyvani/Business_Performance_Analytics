// Rumus Power BI — salin satu measure per kali.

// SALES_KPI
Nilai_6_1 =
VAR pilihanAktif = SELECTEDVALUE('Filter_SALES'[Tahun penjualan], "Semua tahun") RETURN CALCULATE(MAX('SALES_KPI'[K1]), 'SALES_KPI'[Pilihan] = pilihanAktif)

