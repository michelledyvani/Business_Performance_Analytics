// Rumus Power BI — salin satu measure per kali.

// FINANCE_KPI
Nilai_11_1 =
VAR pilihanAktif = SELECTEDVALUE('Filter_FINANCE'[Kuartal], "Semua kuartal") RETURN CALCULATE(MAX('FINANCE_KPI'[K1]), 'FINANCE_KPI'[Pilihan] = pilihanAktif)

